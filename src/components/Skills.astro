---
// Edit skill groups here.
const groups = [
  { name: 'Languages', items: 'Python, C#, TypeScript, PHP, Bash' },
  { name: 'Web & Application Development', items: 'React, .NET, FastAPI, Vue' },
  { name: 'Data & Research Systems', items: 'PostgreSQL, relational data modeling, ETL, Snakemake' },
  { name: 'Cloud & Infrastructure', items: 'AWS, Kubernetes, Docker, Pulumi' },
  { name: 'Engineering Practices', items: 'Testing, CI/CD, Git, code review, documentation, root-cause analysis' },
  { name: 'Requirements & Collaboration', items: 'Requirements gathering, workflow analysis, prototyping, technical communication' },
];
---
<section class="skills-section" id="skills">
  <div class="wrap">
    <div class="section-head"><h2>Languages &amp; Skills</h2></div>
    <dl class="skills">
      {groups.map((g) => (
        <div><dt>{g.name}</dt><dd>{g.items}</dd></div>
      ))}
    </dl>
  </div>
</section>

<style>
  .skills-section { background: var(--bg-soft); padding-top: 4.5rem; }
  .skills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem 2.5rem; margin: 0; }
  dt { font-weight: 600; font-size: 0.97rem; }
  dd { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.99rem; }

  @media (max-width: 960px) {
    .skills { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .skills { grid-template-columns: 1fr; }
  }
</style>
